# 复制为 .env 并填好（docker compose 自动读取）。敏感值勿提交。

# Postgres 密码（compose 里 server 用它拼 DATABASE_URL）
POSTGRES_PASSWORD=change_me_db_password

# 用户 dashboard JWT 密钥（≥16 位强随机；生产必填，否则拒启）
SUB2ORG_JWT_SECRET=change_me_a_long_random_secret_min_16_chars

# /admin/* 令牌（X-Admin-Token；生产必填，否则拒启）
SUB2ORG_ADMIN_TOKEN=change_me_admin_token

# 首启 bootstrap 的 admin 密码（留空=随机生成并在 server 日志打印一次）
SUB2ORG_ADMIN_PASSWORD=change_me_admin_password

# 对外公网基址（拼支付回调 / 邮件链接，必须公网可达的 https 域名）
PUBLIC_BASE_URL=https://sub2org.example.com

# 在线支付（易支付/epay）——留空=不启用在线支付（仍可用兑换码 + admin 充值）
SUB2ORG_EPAY_PID=
SUB2ORG_EPAY_KEY=

# SMTP 发信密码——留空=不发邮件（找回/验证端点返回"未配置"）
SUB2ORG_SMTP_PASSWORD=
