{
  "manifest_version": 3,
  "name": "sub2org-worker",
  "description": "sub2org worker：把本浏览器的 ChatGPT/Claude 登录态接入 sub2org 中转控制中心的 worker 池。",
  "action": {
    "default_popup": "src/pages/popup/index.html",
    "default_icon": {
      "32": "icon-32.png"
    }
  },
  "icons": {
    "128": "icon-128.png"
  },
  "permissions": ["storage", "tabs", "alarms"],
  "storage": {
    "managed_schema": "schema.json"
  },
  "host_permissions": ["https://chatgpt.com/*", "https://claude.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["src/pages/content/index.tsx"],
      "css": ["contentStyle.css"]
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/pages/content/claude-index.tsx"],
      "css": ["contentStyle.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "contentStyle.css",
        "icon-128.png",
        "icon-32.png"
      ],
      "matches": []
    },
    {
      "resources": ["loader.js"],
      "matches": ["https://chatgpt.com/*"]
    },
    {
      "resources": ["loader-claude.js"],
      "matches": ["https://claude.ai/*"]
    },
    {
      "resources": ["src/pages/settings/index.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
